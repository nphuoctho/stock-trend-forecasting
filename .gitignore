# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local datasets and experiment artifacts
/data/
/scratch/
/models/

# Local compressed experiment archives
/outputs/*.zip

# Daily live-prediction artifacts (regenerated by scripts/daily-forecast.sh)
/outputs/live/

# Superseded run artifacts kept on disk for diagnosis only. Their removal from the
# tracked paths is already the record of what changed; committing a second copy
# would add ~28 MB of stale numbers that contradict the current ones.
/outputs/_archive_pre_ci_fix/
